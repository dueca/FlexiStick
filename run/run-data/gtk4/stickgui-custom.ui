<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name stickgui-custom.ui -->
  <requires lib="gtk" version="4.18"/>
  <object class="GtkWindow" id="stick-draw">
    <child>
      <object class="GtkGrid">
        <property name="height-request">0</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="width-request">0</property>
        <child>
          <object class="GtkImage">
            <property name="file">gtk4/background.png</property>
            <property name="pixel-size">200</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">1</property>
              <property name="row">0</property>
              <property name="row-span">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkDrawingArea" id="drawing">
            <property name="content-height">200</property>
            <property name="content-width">200</property>
            <property name="height-request">200</property>
            <property name="width-request">200</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">1</property>
              <property name="row">0</property>
              <property name="row-span">1</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
